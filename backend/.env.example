OPENROUTER_API_KEY=coloque-sua-chave-aqui

# PostgreSQL do docker-compose da raiz (usuário, senha, porta e banco do .env da raiz)
DATABASE_URL=postgresql+psycopg://chatgpt:troque-esta-senha@localhost:5435/modelo_chatgpt

# Segredo para assinar os tokens JWT. Gere um com:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRE_MINUTES=60
